                  "pm.test('200 OK, 4 standard actions created', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.created_permissions.sort()).to.eql([",
                  "        r + ':create', r + ':delete', r + ':read', r + ':update'",
                  "    ].sort());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superuser_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resources\": [\"{{seed_resource}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/permissions/seed",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "permissions", "seed"]
            },
            "description": "Provisions {resource}:create/read/update/delete — matches the spec's own example exactly (resources:[\"user\"] -> user:create/read/update/delete)."
          }
        },
        {
          "name": "Seed Resource Permissions — Idempotent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK, nothing new created the second time', function () {",
