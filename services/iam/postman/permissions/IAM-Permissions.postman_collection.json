                "exec": [
                  "pm.test('200 OK, the repeat counts as failed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ created: 1, failed: 1 });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superuser_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    { \"resource\": \"{{bulk_resource}}\", \"action\": \"create\" },\n    { \"resource\": \"{{bulk_resource}}\", \"action\": \"update\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/permissions/bulk",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "permissions", "bulk"]
            },
            "description": "{{bulk_resource}}:create already exists from the previous request — it's counted in `failed`, :update is genuinely new and counted in `created`."
          }
        },
        {
          "name": "Seed Resource Permissions",
          "event": [
            {
              "listen": "prerequest",
              "script": {
