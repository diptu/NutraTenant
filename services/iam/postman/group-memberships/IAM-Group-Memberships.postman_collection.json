      "name": "1. Create & Read",
      "item": [
        {
          "name": "Create Membership — Alice joins Engineering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('201 Created, matches the spec example', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    var m = body.membership;",
                  "    pm.expect(m.user_id).to.equal(pm.collectionVariables.get('alice_id'));",
                  "    pm.expect(m.group_id).to.equal(pm.collectionVariables.get('engineering_group_id'));",
                  "    pm.expect(m.tenant_id).to.equal(pm.collectionVariables.get('org_slug'));",
                  "    pm.expect(m.membership_type).to.equal('DIRECT');",
                  "    pm.expect(m.role).to.equal('MEMBER');",
                  "    pm.expect(m.status).to.equal('ACTIVE');",
                  "    pm.expect(m.attributes.access_level).to.equal('standard');",
                  "    pm.expect(m.attributes.temporary).to.equal(false);",
                  "});",
                  "pm.collectionVariables.set('alice_membership_id', body.membership.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{alice_id}}\",\n  \"group_id\": \"{{engineering_group_id}}\",\n  \"membership_type\": \"DIRECT\",\n  \"role\": \"MEMBER\",\n  \"attributes\": {\n    \"access_level\": \"standard\",\n    \"temporary\": false\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships"]
            },
            "description": "Reproduces groups-group-memberships-api-spec's own Create Membership example verbatim. No tenant_id needed — owner_access_token's session is already bound to org_slug, and it's validated against the group's own tenant either way."
          }
        },
