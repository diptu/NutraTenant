            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{bob_id}}\",\n  \"group_id\": \"00000000-0000-0000-0000-000000000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships"]
            }
          }
        },
        {
          "name": "Add Bob To Organization (superuser)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('201 Created', function () { pm.expect(pm.response.code).to.equal(201); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superuser_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{bob_id}}\",\n  \"role_code\": \"member\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/organizations/{{organization_id}}/members",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "organizations", "{{organization_id}}", "members"]
            },
            "description": "Org membership isn't actually required to *be added to a group* (only the actor adding someone needs to be the tenant owner) — done here just so Bob can log in and exercise the self-or-superuser list/get checks below."
          }
        },
        {
          "name": "Login Bob (tenant-bound)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK', function () { pm.expect(pm.response.code).to.equal(200); });",
                  "pm.collectionVariables.set('bob_access_token', body.access_token);",
                  "pm.collectionVariables.set('bob_refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{bob_email}}\",\n  \"password\": \"{{bob_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Create Membership — Bob joins Engineering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('201 Created', function () { pm.expect(pm.response.code).to.equal(201); });",
                  "pm.collectionVariables.set('bob_membership_id', body.membership.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{bob_id}}\",\n  \"group_id\": \"{{engineering_group_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships"]
            }
          }
        },
        {
          "name": "Group Member Count Reflects Both Memberships",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('member_count is 2', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().group.member_count).to.equal(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{engineering_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{engineering_group_id}}"]
            }
          }
        },
        {
          "name": "List Memberships By Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK, both memberships listed', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.total).to.equal(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships?group_id={{engineering_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships"],
              "query": [{ "key": "group_id", "value": "{{engineering_group_id}}" }]
            },
            "description": "Listing by group_id requires at least membership in that group's tenant — owner's token (and Alice's/Bob's, since they're org members) all work here."
          }
        },
        {
          "name": "List Memberships By Self (Alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK, just Alice\\'s own membership', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.total).to.equal(1);",
                  "    pm.expect(body.memberships[0].user_id).to.equal(pm.collectionVariables.get('alice_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships?user_id={{alice_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships"],
              "query": [{ "key": "user_id", "value": "{{alice_id}}" }]
            }
          }
        },
        {
          "name": "List Memberships By Other User — Forbidden (Alice queries Bob)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships?user_id={{bob_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships"],
              "query": [{ "key": "user_id", "value": "{{bob_id}}" }]
            },
            "description": "Filtering by user_id alone (no group_id) is self-or-superuser only."
          }
        },
        {
          "name": "Get Membership By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().membership.id).to.equal(pm.collectionVariables.get('alice_membership_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bob_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships/{{alice_membership_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships", "{{alice_membership_id}}"]
            },
            "description": "Reads by id are open to any authenticated user, not just the owner — Bob's token works here even though it's Alice's membership."
          }
        },
        {
          "name": "Get Membership By ID — Unknown (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships", "00000000-0000-0000-0000-000000000000"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Update & Delete",
      "item": [
        {
          "name": "Update Membership — Promote Alice To ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.membership.role).to.equal('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships/{{alice_membership_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships", "{{alice_membership_id}}"]
            }
          }
        },
        {
          "name": "Update Membership — Forbidden For Non-Owner (Bob updates himself)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bob_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships/{{bob_membership_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships", "{{bob_membership_id}}"]
            },
            "description": "Even a membership's own holder can't self-promote — only the tenant owner (or a superuser) can update a membership."
          }
        },
        {
          "name": "Update Membership — Deactivate Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK, INACTIVE', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.membership.status).to.equal('INACTIVE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships/{{alice_membership_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships", "{{alice_membership_id}}"]
            }
          }
        },
        {
          "name": "Group Member Count Drops To 1 After Deactivation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('member_count is 1 (Alice no longer ACTIVE)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().group.member_count).to.equal(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{engineering_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{engineering_group_id}}"]
            },
            "description": "member_count only counts ACTIVE memberships — Bob's is still active, Alice's no longer is."
          }
        },
        {
          "name": "Delete Membership — Remove Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ success: true, message: 'Group membership deleted successfully' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/group-memberships/{{bob_membership_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "group-memberships", "{{bob_membership_id}}"]
            }
          }
