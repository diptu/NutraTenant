          "name": "Update Group — Forbidden For Non-Owner Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employee_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hijacked\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{finance_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{finance_group_id}}"]
            }
          }
        },
        {
          "name": "Update Group — Re-parent Rejects Cycle (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_group_id\": \"{{child_group_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{engineering_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{engineering_group_id}}"]
            },
            "description": "Engineering is already Mobile Engineering's parent (see folder 1) — making Mobile Engineering its parent in turn would close a cycle, so this is rejected rather than corrupting the hierarchy."
          }
        },
