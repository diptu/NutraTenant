      "name": "0. Setup",
      "item": [
        {
          "name": "Login Superuser",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Superuser login succeeded', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('superuser_access_token', body.access_token);",
                  "pm.collectionVariables.set('superuser_refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superuser_email}}\",\n  \"password\": \"{{superuser_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Requires the account named by superuser_email/superuser_password to already exist with is_superuser=true — see scripts/create_superuser.py. Used only to bootstrap the organization below; every Groups request after Setup uses owner_access_token or employee_access_token instead."
          }
        },
