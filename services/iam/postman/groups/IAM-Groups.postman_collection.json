    {
      "name": "1. Create & Read",
      "item": [
        {
          "name": "Create Group — Finance Team",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('201 Created, matches the spec example plus the Common Group Object extras', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    var g = body.group;",
                  "    pm.expect(g.name).to.equal('Finance Team');",
                  "    pm.expect(g.tenant_id).to.equal(pm.collectionVariables.get('org_slug'));",
                  "    pm.expect(g.type).to.equal('SYSTEM');",
                  "    pm.expect(g.status).to.equal('ACTIVE');",
                  "    pm.expect(g.member_count).to.equal(0);",
                  "    pm.expect(g.attributes.department).to.equal('Finance');",
                  "    pm.expect(g.attributes.clearance_level).to.equal(3);",
                  "    pm.expect(g.metadata.tags).to.eql(['finance', 'internal']);",
                  "});",
                  "pm.collectionVariables.set('finance_group_id', body.group.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Finance Team\",\n  \"description\": \"Finance department users\",\n  \"type\": \"SYSTEM\",\n  \"attributes\": {\n    \"department\": \"Finance\",\n    \"clearance_level\": 3,\n    \"region\": \"USA\"\n  },\n  \"metadata\": {\n    \"tags\": [\"finance\", \"internal\"]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            },
            "description": "Reproduces groups-group-memberships-api-spec's own Create Group example almost verbatim (region adapted to USA to match scripts/dummy.json's Apple Corp employees, who are all US-based) — attributes/clearance_level here line up with David Taylor (usr_apple_mod_002, Finance Lead, clearance_level 3). No tenant_id needed — owner_access_token's session is already bound to org_slug."
          }
        },
        {
          "name": "Create Group — Engineering",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('201 Created', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(body.group.type).to.equal('CUSTOM');",
                  "});",
                  "pm.collectionVariables.set('engineering_group_id', body.group.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\",\n  \"description\": \"Engineering department\",\n  \"attributes\": {\n    \"department\": \"Engineering\",\n    \"region\": \"USA\"\n  },\n  \"metadata\": {\n    \"tags\": [\"engineering\"]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            },
            "description": "scripts/dummy.json grp_eng. Omits `type` to demonstrate the CUSTOM default — Alice Miller/Bob Davis (usr_apple_mem_001/002) join this group in ../group-memberships."
          }
        },
        {
          "name": "Create Group — Mobile Engineering (child of Engineering)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('201 Created, parent_group_id set', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(body.group.parent_group_id).to.equal(pm.collectionVariables.get('engineering_group_id'));",
                  "});",
                  "pm.collectionVariables.set('child_group_id', body.group.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile Engineering\",\n  \"parent_group_id\": \"{{engineering_group_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            },
            "description": "Demonstrates the parent_group_id hierarchy — not in scripts/dummy.json's flat group list, added here purely to exercise nesting."
          }
        },
        {
          "name": "Create Group — Forbidden For Non-Owner Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employee_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Shadow Group\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            },
            "description": "Sarah (a plain member, not Apple Corp's owner) can't create groups in her own tenant — managing groups requires being that tenant's owner (or a platform superuser, which this collection deliberately never uses for Groups requests)."
          }
        },
        {
          "name": "Create Group — Without Tenant Context (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superuser_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Tenant\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            },
            "description": "superuser_access_token has no tenant context at all (see Setup > Login Superuser in ../roles) and no explicit tenant_id was given — unlike Role, a group has no global/platform variant, so this 400s rather than creating a global group."
          }
        },
        {
          "name": "List Groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK, pagination envelope, includes Finance Team', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.page).to.equal(1);",
                  "    pm.expect(body.page_size).to.equal(20);",
                  "    pm.expect(body.groups.some(function (g) { return g.id === pm.collectionVariables.get('finance_group_id'); })).to.equal(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/groups?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            },
            "description": "owner_access_token's session is tenant-bound, so no tenant_id query param is needed here. Listing requires at least membership in the tenant (employee_access_token would also work here, just not for create/update/delete)."
          }
        },
