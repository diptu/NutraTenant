    {
      "name": "2. Update, Hierarchy & Delete",
      "item": [
        {
          "name": "Update Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('200 OK, fields updated', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.group.description).to.equal('Finance & Accounting department users');",
                  "    pm.expect(body.group.attributes.clearance_level).to.equal(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{owner_access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Finance & Accounting department users\",\n  \"attributes\": {\n    \"department\": \"Finance\",\n    \"clearance_level\": 4,\n    \"region\": \"USA\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{finance_group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{finance_group_id}}"]
            }
          }
        },
