            "header": [{ "key": "Authorization", "value": "Bearer {{member_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        }
      ]
    },
