    {
      "name": "6. Tenant Membership",
      "description": "Uses a freshly-registered 'outsider' user who isn't a member of {{org_slug}} yet — member_user_id and created_user_id are both already members of it by this point (added in Setup / via Create User's tenant_id), so POST .../tenants against either would 409 as 'already a member' instead of demonstrating the happy path.",
      "item": [
        {
          "name": "Register Outsider User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var ts = Date.now();",
                  "pm.collectionVariables.set('outsider_email', 'outsider.' + ts + '@example.com');",
                  "pm.collectionVariables.set('outsider_password', 'Sup3rSecret!23');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Outsider registered', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('outsider_user_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
