                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns the Common User Object', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.email).to.equal(pm.collectionVariables.get('member_email'));",
