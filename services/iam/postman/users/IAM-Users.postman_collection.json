  "item": [
    {
      "name": "0. Setup",
      "description": "Bootstraps everything the later folders need: a logged-in superuser, a fresh member account, an organization the member belongs to, and the seeded global role catalog.",
      "item": [
        {
          "name": "Login Superuser",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Superuser login succeeded', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('superuser_access_token', body.access_token);",
                  "pm.collectionVariables.set('superuser_refresh_token', body.refresh_token);",
                  "if (body.user && body.user.id) {",
                  "    pm.collectionVariables.set('superuser_user_id', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superuser_email}}\",\n  \"password\": \"{{superuser_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Requires the account named by superuser_email/superuser_password to already exist and have is_superuser=true — see the collection description for `scripts/create_superuser.py`."
          }
        },
        {
          "name": "Register Member User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var ts = Date.now();",
                  "pm.collectionVariables.set('member_email', 'member.' + ts + '@example.com');",
                  "pm.collectionVariables.set('member_password', 'Sup3rSecret!23');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Member registered', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.collectionVariables.set('member_user_id', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\",\n  \"full_name\": \"Jane Doe\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
