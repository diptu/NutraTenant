        {
          "name": "Login Member User (tenant-bound)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Tenant-bound login succeeded', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "    // tenant_id isn't duplicated in body.user.tenant — it's already",
                  "    // the access token's own tenant_id claim.",
                  "    var claims = JSON.parse(atob(body.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(claims.tenant_id).to.equal(pm.collectionVariables.get('org_slug'));",
                  "});",
                  "pm.collectionVariables.set('member_access_token', body.access_token);",
                  "pm.collectionVariables.set('member_refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\",\n  \"tenant_id\": \"{{org_slug}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Re-logs in now that the member has a tenant membership, so the access token carries a tenant_id claim — GET /users/me and the permission-grant endpoints below need that to resolve tenant/role/permissions context."
          }
        },
        {
          "name": "Seed Global Roles (superuser)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Roles seeded', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "var roles = pm.response.json();",
                  "roles.forEach(function (r) {",
                  "    if (r.code === 'member') pm.collectionVariables.set('member_role_id', r.id);",
                  "    if (r.code === 'admin') pm.collectionVariables.set('admin_role_id', r.id);",
                  "    if (r.code === 'guest') pm.collectionVariables.set('guest_role_id', r.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{superuser_access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/roles/seed",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "seed"]
            },
            "description": "Idempotent — creates the global admin/member/guest roles if missing. Needed before '3. Roles' can assign one to the member by code."
          }
        },
        {
          "name": "Refresh Member Access Token (manual demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var body = pm.response.json();",
                  "pm.test('Refreshed', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "pm.collectionVariables.set('member_access_token', body.access_token);",
                  "pm.collectionVariables.set('member_refresh_token', body.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{member_refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Not required for normal runs — the collection-level pre-request script already does this automatically for both actors whenever a stored access token is within 5s of expiring. Kept here as an explicit, on-demand way to rotate it."
          }
        }
      ]
    },
    {
