# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=nutratenant-identity-service
ENVIRONMENT=development
DEBUG=false

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# (Neon connection strings work as-is with the asyncpg driver.) Port 5433
# matches docker-compose.yml's mapping, chosen to avoid clashing with a
# system-wide Postgres install that many dev machines already run on 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/nutratenant_identity
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=3600

# Fernet key encrypting TOTP secrets at rest — must be a valid 32-byte
# urlsafe-base64 key (unlike JWT_SECRET_KEY, an arbitrary string here will
# crash MFA endpoints at first use). This dev-only key is safe to use
# locally but regenerate a real one for any non-local deployment with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_SECRET_ENCRYPTION_KEY=JsaKd0V4JCvvLuGZU7JCfzV559YLSa-uGe6hfgCTajg=
MFA_CHALLENGE_TOKEN_EXPIRE_MINUTES=5
MFA_RECOVERY_CODE_COUNT=8
